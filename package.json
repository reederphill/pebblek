{
  "name": "PebbleK",
  "author": "iuri aranda <iuri.aranda@gmail.com>",
  "version": "0.1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "pebble": {
    "displayName": "PebbleK",
    "uuid": "c380dc5d-2c4b-4211-a7b8-67fea3d4586a",
    "projectType": "native",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "HEADING",
      "AUTOPILOT_STATE",
      "SOG",
      "WIND_SPEED",
      "WIND_ANGLE",
      "CONNECTION_STATUS",
      "CMD_ADJUST_HEADING",
      "CMD_SET_STATE",
      "CMD_RESULT",
      "TARGET_HEADING",
      "TARGET_WIND_ANGLE",
      "STW",
      "TRUE_WIND_SPEED",
      "TRUE_WIND_ANGLE",
      "HEADING_TIME",
      "AUTOPILOT_STATE_TIME",
      "SOG_TIME",
      "STW_TIME",
      "WIND_SPEED_TIME",
      "WIND_ANGLE_TIME",
      "TRUE_WIND_SPEED_TIME",
      "TRUE_WIND_ANGLE_TIME",
      "TARGET_HEADING_TIME",
      "TARGET_WIND_ANGLE_TIME",
      "ALERT_ID",
      "ALERT_LEVEL",
      "ALERT_TEXT",
      "ALERT_NOTIFY",
      "ALERT_SYNC",
      "ALERT_RESYNC"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        },
        {
          "type": "font",
          "name": "FONT_ROBOTO_BOLD_96",
          "targetPlatforms": ["gabbro"],
          "file": "fonts/Roboto-Bold.ttf",
          "characterRegex": "[0-9]"
        },
        {
          "type": "font",
          "name": "FONT_ROBOTO_BOLD_48",
          "targetPlatforms": ["emery"],
          "file": "fonts/Roboto-Bold.ttf",
          "characterRegex": "[0-9°-]"
        },
        {
          "type": "font",
          "name": "FONT_ROBOTO_BOLD_36",
          "file": "fonts/Roboto-Bold.ttf",
          "characterRegex": "[0-9.\\-]"
        }
      ]
    },
    "usesPermissions": [
      "LocalNetwork",
      "Internet"
    ]
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  }
}
