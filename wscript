import json
import os.path

top = '.'
out = 'build'


# Dev convenience: hardcode build-time overrides for emulator/dev testing. Both
# are set via env vars at build time and baked into the gitignored pkjs file
# src/pkjs/buildconfig.js (required via src/pkjs/settings.js). Unset => empty
# string => normal user-configured behaviour.
#   PEBBLEK_DEV_SERVER=http://localhost:3000  hardcode the SignalK server, so the
#                                             app skips the Clay config step.
#   PEBBLEK_DEVICE_UUID=<uuid>                use a static access-request clientId
#                                             instead of a random per-device one,
#                                             so the server recognises the watch
#                                             across reinstalls (approve once).
#   PEBBLEK_DEVICE_TOKEN=<jwt>                a pre-minted SignalK device token, so
#                                             the watch skips the access-request
#                                             flow entirely (no manual approval on
#                                             each emulator launch).
def _write_pkjs_buildconfig(ctx):
    dev_server = os.environ.get('PEBBLEK_DEV_SERVER', '')
    device_uuid = os.environ.get('PEBBLEK_DEVICE_UUID', '')
    device_token = os.environ.get('PEBBLEK_DEVICE_TOKEN', '')
    content = (
        '// AUTO-GENERATED by wscript from PEBBLEK_DEV_SERVER / PEBBLEK_DEVICE_UUID /\n'
        '// PEBBLEK_DEVICE_TOKEN. Do not edit by hand; this file is gitignored.\n'
        'module.exports = {\n'
        '  devServer: ' + json.dumps(dev_server) + ',\n'
        '  deviceUuid: ' + json.dumps(device_uuid) + ',\n'
        '  deviceToken: ' + json.dumps(device_token) + ',\n'
        '};\n'
    )
    node = ctx.path.make_node('src/pkjs/buildconfig.js')
    try:
        unchanged = node.read() == content
    except (OSError, IOError):
        unchanged = False
    if not unchanged:  # avoid touching the file (and forcing a rebundle) when stable
        node.write(content)
    if dev_server:
        ctx.msg('pebblek dev server', dev_server)
    if device_uuid:
        ctx.msg('pebblek device uuid', device_uuid)
    if device_token:
        ctx.msg('pebblek device token', device_token[:12] + '...')


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    """
    This method is used to configure your build. ctx.load(`pebble_sdk`) automatically configures
    a build for each valid platform in `targetPlatforms`. Platform-specific configuration: add your
    change after calling ctx.load('pebble_sdk') and make sure to set the correct environment first.
    Universal configuration: add your change prior to calling ctx.load('pebble_sdk').
    """
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')

    _write_pkjs_buildconfig(ctx)

    build_worker = os.path.exists('worker_src')
    binaries = []

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app')

        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform, 'app_elf': app_elf, 'worker_elf': worker_elf})
            ctx.pbl_build(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                          target=worker_elf,
                          bin_type='worker')
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js')
